# Copiez ce fichier vers ".env" et remplissez avec vos vraies valeurs.

# Chaîne de connexion PostgreSQL fournie par Supabase :
# Project Settings > Database > Connection string > URI (mode "Transaction")
DATABASE_URL=postgresql://postgres:RAMAdiop197@db.gfvvvixndskqaeocfowo.supabase.co:5432/postgres

# Clé secrète pour signer les tokens JWT — générez-en une longue et aléatoire
# (ex: openssl rand -hex 32) et ne la partagez jamais.
JWT_SECRET=remplacez-moi-par-une-cle-secrete-aleatoire-et-longue

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# Domaines autorisés à appeler l'API (séparés par virgule si plusieurs)
CORS_ORIGINS=["*"]
